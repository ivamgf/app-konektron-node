# URL da API. Em desenvolvimento, deixe /api/v1: o Vite encaminha para VITE_API_PROXY.
VITE_API_URL=/api/v1
# Para onde o Vite encaminha /api em desenvolvimento (API rodando localmente)
VITE_API_PROXY=http://localhost:3333
# ID do cliente OAuth do Google (o mesmo GOOGLE_CLIENT_ID da API). Vazio esconde o login com Google.
VITE_GOOGLE_CLIENT_ID=
